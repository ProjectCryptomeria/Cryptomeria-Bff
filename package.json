{
  "name": "cryptomeria-bff",
  "version": "1.0.0",
  "description": "Cryptomeria 実験用BFFサーバー (Backend for Frontend)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "init": "cp .env.example .env",
    "test":"tsx tests/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@kubernetes/client-node": "^0.22.3",
    "dotenv": "^17.2.3",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.12.0"
}
