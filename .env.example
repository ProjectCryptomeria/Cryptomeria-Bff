# 必須設定
NODE_HOST=localhost

# 認証
# - AUTH_DISABLED=true の場合、/api/v1 配下の Bearer 認証を無効化します（ローカル開発専用推奨）
# - AUTH_DISABLED=false（デフォルト）の場合、API_TOKEN が必須です
AUTH_DISABLED=false
API_TOKEN=your-secret-token

# Kubernetes
K8S_NAMESPACE=cryptomeria

# オプション設定（デフォルト値あり）
# DOWNSTREAM_TIMEOUT_MS=10000
# MAX_TX_BASE64_CHARS=5000000
# ENDPOINT_CACHE_TTL_MS=10000
# AUTO_DETECT_NODE_HOST=false

# サーバー設定
# PORT=3000
